# Copy to .env (backend/scripts) and web/.env.local (frontend). Never commit real values.
# Auth uses Application Default Credentials: run `gcloud auth application-default login` locally.
# No API keys are needed or allowed.

# --- api/ and scripts/ ---
GCP_PROJECT=your-project-id
GCP_LOCATION=global
BQ_DATASET=personapulse
# Private bucket for uploaded product images (Cloud Storage). Leave empty to skip storing images.
GCS_BUCKET=your-project-id-personapulse-images
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_PRO_FALLBACK_MODEL=gemini-2.5-pro
# BigQuery AI remote model (must be available in the BigQuery location)
BQAI_MODEL=gemini-2.5-flash
ALLOWED_ORIGINS=http://localhost:3000
MAX_LIVE_PERSONAS=30
# Optional tuning
GEMINI_CONCURRENCY=30
GEMINI_TIMEOUT_S=45
RATE_LIMIT_PER_MIN=5

# --- web/ (build-time) ---
NEXT_PUBLIC_API_URL=http://localhost:8080
